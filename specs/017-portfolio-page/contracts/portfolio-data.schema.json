{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://zacharypaynethompson.github.io/blog/schemas/portfolio-data.schema.json",
  "title": "Portfolio Data",
  "description": "Shape of src/_data/portfolio.json driving the /portfolio/ page.",
  "type": "object",
  "additionalProperties": false,
  "required": ["categories"],
  "properties": {
    "intro": {
      "type": "string",
      "description": "Optional lead paragraph shown under the page heading."
    },
    "categories": {
      "type": "array",
      "description": "Ordered list of categories; array order is display order.",
      "items": { "$ref": "#/$defs/category" }
    }
  },
  "$defs": {
    "category": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "name", "projects"],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z0-9-]+$",
          "description": "Stable slug used for the section anchor; unique within the file."
        },
        "name": {
          "type": "string",
          "minLength": 1,
          "description": "Display heading for the category section."
        },
        "blurb": {
          "type": "string",
          "description": "Optional one-line description under the category heading."
        },
        "projects": {
          "type": "array",
          "description": "Ordered list of projects; array order is display order.",
          "items": { "$ref": "#/$defs/project" }
        }
      }
    },
    "project": {
      "type": "object",
      "additionalProperties": false,
      "required": ["title", "description"],
      "properties": {
        "title": { "type": "string", "minLength": 1 },
        "description": { "type": "string", "minLength": 1 },
        "role": { "type": "string" },
        "year": { "type": "string" },
        "tags": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 }
        },
        "links": {
          "type": "array",
          "items": { "$ref": "#/$defs/link" }
        }
      }
    },
    "link": {
      "type": "object",
      "additionalProperties": false,
      "required": ["label", "url"],
      "properties": {
        "label": {
          "type": "string",
          "minLength": 1,
          "description": "Human- and agent-readable anchor text."
        },
        "url": {
          "type": "string",
          "format": "uri",
          "description": "Absolute URL to the destination resource."
        },
        "type": {
          "type": "string",
          "enum": ["web", "pdf", "github", "post"],
          "description": "Optional hint for iconography; not required for MVP."
        }
      }
    }
  }
}
